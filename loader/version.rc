#include <winres.h>
#include "version.h"

#define BLTD_FILE_NAME "bltd-bots.asi"
#define BLTD_DESCRIPTION "Blacklight: Tango Down enhancements mod"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BLTD_VERSION_NUMBERS
 PRODUCTVERSION BLTD_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", BLTD_DESCRIPTION
            VALUE "FileVersion", BLTD_VERSION_TEXT
            VALUE "InternalName", BLTD_FILE_NAME
            VALUE "OriginalFilename", BLTD_FILE_NAME
            VALUE "ProductName", "Blacklight: Tango Down enhancements mod"
            VALUE "ProductVersion", BLTD_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
